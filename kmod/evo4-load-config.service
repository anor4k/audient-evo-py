[Unit]
Description=Load Audient EVO4 configuration on device connection
ConditionPathExists=/dev/evo4
ConditionPathExists=%h/.config/audient-evo-py/evo4/config.json

[Service]
Type=oneshot
ExecStart=%h/.local/bin/evoctl --device evo4 load
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
